{
  "manifest_version": 3,
  "name": "Social Auto Scroller",
  "version": "1.0.2",
  "description": "Scroll social-media feeds automatically with speed, limits, and scroll-area controls.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Social Auto Scroller",
    "default_popup": "popup.html"
  }
}
