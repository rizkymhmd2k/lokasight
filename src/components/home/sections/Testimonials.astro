---
import nadineAvatar from "../../../assets/images/testimonial-nadine-circle.png";
import elliotAvatar from "../../../assets/images/testimonial-elliot-circle.png";
import meiAvatar from "../../../assets/images/testimonial-mei-circle.png";
import { Image } from "astro:assets";

const testimonials = [
  {
    role: "Brand Director · Sora Botanics, Jakarta",
    quote: "They listened before they designed. That made all the difference.",
    highlight: "The new identity feels distinctly Indonesian, without leaning on clichés.",
    author: "Nadine Prasetyo",
    avatar: nadineAvatar,
  },
  {
    role: "Co-founder · Fieldnote Labs, London",
    quote: "The process was clear, collaborative, and refreshingly free of theatre.",
    highlight: "We launched with a brand our whole team could stand behind.",
    author: "Elliot Mercer",
    avatar: elliotAvatar,
  },
  {
    role: "Product Lead · Northstar Health, Singapore",
    quote: "They turned a complicated product into an experience people understood immediately.",
    highlight: "Every choice felt thoughtful, useful, and true to us.",
    author: "Mei Lin Tan",
    avatar: meiAvatar,
  },
];
---

<section id="testimonials" class="testimonials" aria-labelledby="testimonials-title">
  <div class="testimonials__inner">
    <header class="testimonials__header">
      <p class="typography-label">[TESTIMONIALS]</p>
      <h2 id="testimonials-title" aria-label="Good people. Great partnerships.">
        <span class="testimonials__headline-line">
          <span>Good people.</span>
          <span class="testimonials__headline-graphic testimonials__headline-graphic--smiley" aria-hidden="true">
            <svg viewBox="0 0 88 88" fill="none" focusable="false">
              <path d="M44.7 5.8C66.5 4.7 80 20.6 80.4 42.7c.4 22.8-13.5 39-35.9 39.5C22.8 82.7 7.8 67.7 7.4 45 7 22.9 22.1 6.9 44.7 5.8Z" />
              <path d="M31.4 29.3c2.7-.2 4.4 2 4.4 5.5 0 3.7-1.7 6-4.4 6.1-2.6 0-4.3-2.2-4.3-5.7 0-3.6 1.6-5.7 4.3-5.9Zm25.4-.2c2.7 0 4.3 2.2 4.2 5.7-.1 3.7-1.9 5.9-4.6 5.8-2.6-.1-4.2-2.4-4-5.9.1-3.6 1.7-5.7 4.4-5.6Z" />
              <path d="M24.7 50.7c2.9 10.8 10 16.4 20.8 16.2 10.6-.2 17.3-5.8 19.8-16.7" />
            </svg>
          </span>
        </span>
        <span class="testimonials__headline-line">
          <span>Great</span>
          <span class="testimonials__headline-graphic testimonials__headline-graphic--spark" aria-hidden="true">
            <svg viewBox="0 0 106 104" fill="none" focusable="false">
              <path d="m53 2 9 30 28-17-13 29 28 6-29 9 19 24-31-12-8 31-10-30-29 18 14-30-30-7 31-10L12 20l32 12L53 2Z" />
            </svg>
          </span>
        </span>
        <span class="testimonials__headline-line">partnerships.</span>
      </h2>
      <p class="testimonials__intro">A few kind words.<br />A lot of shared ambition.</p>
    </header>

    <testimonial-deck class="testimonials__deck" role="region" aria-roledescription="carousel" aria-label="Client testimonials">
      <div class="testimonials__stack">
        {testimonials.map((item, index) => (
          <article class:list={["testimonials__card", { "testimonials__card--dark": index === 1, "testimonials__card--paper": index === 2 }]} data-card data-author={item.author}>
            <figure>
              <blockquote>
                <span class="testimonials__quote-mark" aria-hidden="true">“</span>
                <p>{item.quote} <span>{item.highlight}</span></p>
              </blockquote>
              <figcaption>
                <Image src={item.avatar} alt="" width={80} height={80} quality={100} format="png" loading="lazy" />
                <div>
                  <strong>{item.author}</strong>
                  <span class="testimonials__discipline">{item.role}</span>
                </div>
              </figcaption>
            </figure>
            <button class="testimonials__pick" type="button" data-pick={index} aria-label={`Show testimonial from ${item.author}`} tabindex="-1" hidden></button>
          </article>
        ))}
      </div>
      <div class="testimonials__controls" hidden>
        <div class="testimonials__navigation">
          <button type="button" data-step="-1" aria-label="Previous testimonial">
            <svg viewBox="0 0 64 32" fill="none" aria-hidden="true">
              <path d="M57.5 15.7c-12.8-.4-26.2-.1-49.7.7" />
              <path d="M18.2 6.7c-3.4 3.4-6.8 6.5-10.4 9.7 3.7 2.8 7 5.8 10 9" />
            </svg>
          </button>
          <button type="button" data-step="1" aria-label="Next testimonial">
            <svg viewBox="0 0 64 32" fill="none" aria-hidden="true">
              <path d="M6.5 16.3c12.8.4 26.2.1 49.7-.7" />
              <path d="M45.8 25.3c3.4-3.4 6.8-6.5 10.4-9.7-3.7-2.8-7-5.8-10-9" />
            </svg>
          </button>
        </div>
      </div>
      <p class="testimonials__status" aria-live="polite" aria-atomic="true"></p>
    </testimonial-deck>
  </div>
</section>

<style>
  .testimonials {
    overflow: clip;
    padding-block: var(--spacing-section);
    background: var(--color-backgroundlight);
    color: var(--color-black);
    font-family: var(--font-sans);
  }
  .testimonials__inner {
    max-width: 90rem;
    margin-inline: auto;
    padding-inline: var(--spacing-page-gutter);
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    align-items: center;
    gap: 4rem;
  }
  .testimonials__header h2 {
    margin: 2rem 0 1.75rem;
    font-size: clamp(2.5rem, 4.5vw, 4.5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.055em;
  }
  .testimonials__headline-line {
    display: flex;
    width: max-content;
    max-width: 100%;
    align-items: center;
    gap: 0.2em;
  }
  .testimonials__headline-graphic {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    transform-origin: center;
  }
  .testimonials__headline-graphic svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .testimonials__headline-graphic--smiley {
    width: 0.82em;
    height: 0.82em;
    color: #55544f;
    animation: testimonials-smiley-wobble 4.8s ease-in-out infinite;
  }
  .testimonials__headline-graphic--smiley path:first-child,
  .testimonials__headline-graphic--smiley path:last-child {
    stroke: currentColor;
    stroke-width: 6.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .testimonials__headline-graphic--smiley path:nth-child(2) { fill: currentColor; }
  .testimonials__headline-graphic--spark {
    width: 0.9em;
    height: 0.9em;
    color: #f3bd56;
    animation: testimonials-spark-pulse 3.4s ease-in-out infinite;
  }
  .testimonials__headline-graphic--spark path { fill: currentColor; }
  @keyframes testimonials-smiley-wobble {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(-0.035em) rotate(3deg); }
  }
  @keyframes testimonials-spark-pulse {
    0%, 100% { transform: rotate(-5deg) scale(0.96); }
    50% { transform: rotate(4deg) scale(1.06); }
  }
  .testimonials__intro { font-size: 1rem; line-height: 1.6; opacity: 0.6; }
  .testimonials__deck { display: block; min-width: 0; width: 100%; max-width: 38rem; margin-inline: auto; }
  .testimonials__stack { display: grid; gap: 1.5rem; }
  .testimonials__card {
    position: relative;
    min-width: 0;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid rgb(0 0 0 / 14%);
    border-radius: 1.5rem;
    background: var(--color-yellow1);
    color: var(--color-black);
    transform-origin: 50% 80%;
  }
  .testimonials__card--dark { background: var(--color-black); color: var(--color-backgroundlight); }
  .testimonials__card--paper { background: #e8e5dc; }
  figure { margin: 0; display: flex; flex-direction: column; flex: 1; }
  blockquote { margin: 0 0 2.5rem; }
  .testimonials__quote-mark {
    display: block;
    height: 4.5rem;
    padding-top: 1.25rem;
    font-size: 6rem;
    line-height: 1;
    font-family: Georgia, serif;
  }
  blockquote p {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.15vw, 1.9375rem);
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: -0.035em;
  }
  figcaption { display: flex; align-items: center; gap: 0.875rem; margin-top: auto; }
  figcaption img { width: 3rem; height: 3rem; flex-shrink: 0; border-radius: 50%; background: var(--color-backgroundlight); }
  figcaption strong { display: block; font-size: 0.875rem; font-weight: 600; }
  .testimonials__discipline { display: block; margin-top: 0.25rem; font-size: 0.6875rem; line-height: 1.5; opacity: 0.7; }
  .testimonials__deck[data-ready] .testimonials__stack {
    isolation: isolate;
    gap: 0;
    margin: 2.5rem 2rem 1.5rem;
    touch-action: pan-y pinch-zoom;
  }
  .testimonials__deck[data-ready] .testimonials__card {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    min-height: 31rem;
  }
  [data-position="0"] { z-index: 3; transform: rotate(-3deg); }
  [data-position="1"] { z-index: 2; transform: translate(7%, -1%) rotate(7deg); }
  [data-position="2"] { z-index: 1; transform: translate(-6%, 1%) rotate(-9deg); }
  .testimonials__pick { position: absolute; inset: 0; width: 100%; border: 0; border-radius: inherit; background: transparent; cursor: pointer; }
  .testimonials__controls { display: flex; align-items: center; justify-content: center; gap: 1rem; padding-top: 1rem; }
  [hidden] { display: none !important; }
  .testimonials__navigation { display: flex; align-items: center; justify-content: center; gap: 3rem; }
  .testimonials__navigation button {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    color: var(--color-black);
    background: transparent;
    cursor: pointer;
    transition: transform 180ms ease;
  }
  @media (hover: hover) {
    .testimonials__navigation button:hover { transform: scale(1.08) rotate(-2deg); }
    .testimonials__navigation button:last-child:hover { transform: scale(1.08) rotate(2deg); }
  }
  button:focus-visible { outline: 3px solid #6863ef; outline-offset: 5px; }
  .testimonials__navigation svg {
    width: 100%;
    overflow: visible;
    stroke: currentColor;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .testimonials__status { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 1023px) {
    .testimonials__inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .testimonials__header h2 { font-size: clamp(2.75rem, 7vw, 4rem); }
    .testimonials__intro { margin-bottom: 0; }
    .testimonials__deck { width: 100%; max-width: 38rem; margin-inline: auto; }
    blockquote p { font-size: clamp(1.375rem, 4vw, 1.875rem); }
  }
  @media (max-width: 479px) {
    .testimonials__inner { gap: 1.5rem; }
    .testimonials__header h2 { font-size: 2.5rem; letter-spacing: -0.045em; }
    .testimonials__deck[data-ready] .testimonials__stack { margin-inline: 1.5rem; margin-bottom: 1.5rem; }
    [data-position="1"] { transform: translate(4%, -1%) rotate(5deg); }
    [data-position="2"] { transform: translate(-4%, 1%) rotate(-5deg); }
    .testimonials__deck[data-ready] .testimonials__card { min-height: 29rem; padding: 1.25rem; }
    .testimonials__controls { flex-direction: column-reverse; gap: 1rem; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .testimonials__navigation button { transition: none; }
    .testimonials__headline-graphic { animation: none; }
  }
</style>

<script>
  class TestimonialDeck extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      this.cleanup?.();
      const cards = Array.from(this.querySelectorAll<HTMLElement>("[data-card]"));
      const stack = this.querySelector<HTMLElement>(".testimonials__stack")!;
      const controls = this.querySelector<HTMLElement>(".testimonials__controls")!;
      const status = this.querySelector<HTMLElement>(".testimonials__status")!;
      const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const controller = new AbortController();
      const { signal } = controller;
      let active = 0;
      let busy = false;
      let animations: Animation[] = [];
      let touchStart: { x: number; y: number } | undefined;
      const render = () => {
        cards.forEach((card, index) => {
          const position = (index - active + cards.length) % cards.length;
          card.dataset.position = String(position);
          card.setAttribute("aria-hidden", String(position !== 0));
          card.querySelector<HTMLButtonElement>("[data-pick]")!.hidden = position === 0;
        });
      };

      const select = async (next: number, direction = 1) => {
        if (busy || next === active) return;
        busy = true;
        try {
          const before = cards.map((card) => getComputedStyle(card).transform);
          if (!motion.matches) {
            const outgoing = cards[active].animate([
              { transform: before[active] },
              { transform: `translate(${direction * -65}%, -5%) rotate(${direction * -16}deg)` },
            ], { duration: 200, easing: "cubic-bezier(.4,0,1,1)", fill: "forwards" });
            animations = [outgoing];
            await outgoing.finished;
            before[active] = getComputedStyle(cards[active]).transform;
            outgoing.cancel();
          }
          active = next;
          render();
          if (!motion.matches) {
            animations = cards.map((card, index) => card.animate([
              { transform: before[index] },
              { transform: getComputedStyle(card).transform },
            ], { duration: 450, easing: "cubic-bezier(.22,1,.36,1)" }));
            await Promise.all(animations.map((animation) => animation.finished));
          }
          status.textContent = `Testimonial ${active + 1} of ${cards.length}, ${cards[active].dataset.author}.`;
        } catch (error) {
          // Disconnecting or enabling reduced motion cancels in-flight animations.
          if (!(error instanceof DOMException && error.name === "AbortError")) throw error;
        } finally {
          animations = [];
          busy = false;
        }
      };
      const step = (direction: number) => void select((active + direction + cards.length) % cards.length, direction);
      this.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;
        const button = event.target.closest<HTMLButtonElement>("button");
        if (button?.dataset.step) step(Number(button.dataset.step));
        else if (button?.dataset.pick) void select(Number(button.dataset.pick));
      }, { signal });
      this.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        step(event.key === "ArrowRight" ? 1 : -1);
      }, { signal });
      stack.addEventListener("touchstart", (event) => {
        touchStart = event.touches.length === 1 ? { x: event.touches[0].clientX, y: event.touches[0].clientY } : undefined;
      }, { passive: true, signal });
      stack.addEventListener("touchend", (event) => {
        if (!touchStart) return;
        const dx = event.changedTouches[0].clientX - touchStart.x;
        const dy = event.changedTouches[0].clientY - touchStart.y;
        touchStart = undefined;
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.5) step(dx < 0 ? 1 : -1);
      }, { passive: true, signal });
      stack.addEventListener("touchcancel", () => { touchStart = undefined; }, { signal });
      motion.addEventListener("change", () => animations.forEach((animation) => animation.finish()), { signal });
      render();
      this.dataset.ready = "";
      controls.hidden = false;
      this.cleanup = () => {
        controller.abort();
        animations.forEach((animation) => animation.cancel());
      };
    }

    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get("testimonial-deck")) customElements.define("testimonial-deck", TestimonialDeck);
</script>
