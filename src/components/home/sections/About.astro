---
import teamImage from "../../../assets/images/team1.png";

const ICON_BTN =
  "inline-flex h-11 w-11 md:h-12 md:w-12 lg:h-14 lg:w-14 items-center justify-center rounded-full text-black/45 hover:text-black/70 transition";

const socials = [
  {
    label: "Instagram",
    href: "#",
    svg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9A5.5 5.5 0 0 1 16.5 22h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Z" stroke="currentColor" stroke-width="1.8" /><path d="M12 16.2a4.2 4.2 0 1 0 0-8.4 4.2 4.2 0 0 0 0 8.4Z" stroke="currentColor" stroke-width="1.8" /><path d="M17.3 6.9h.01" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg>`,
  },
  {
    label: "TikTok",
    href: "#",
    svg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 3v10.2a3.8 3.8 0 1 1-3.1-3.7V7.6a7 7 0 1 0 6.9 7V9.3c.9.7 2 1.1 3.2 1.2V7.7c-2.1-.2-3.8-1.9-4-4H14Z" fill="currentColor" opacity="0.9" /></svg>`,
  },
  {
    label: "LinkedIn",
    href: "#",
    svg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.3 9.2H3.8V20h2.5V9.2Z" fill="currentColor" opacity="0.9" /><path d="M5.05 7.9a1.45 1.45 0 1 0 0-2.9 1.45 1.45 0 0 0 0 2.9Z" fill="currentColor" opacity="0.9" /><path d="M10 9.2h2.4v1.5h.03c.34-.64 1.17-1.62 2.7-1.62 2.9 0 3.44 1.9 3.44 4.37V20h-2.5v-5.77c0-1.38-.03-3.15-1.92-3.15-1.92 0-2.22 1.5-2.22 3.05V20H10V9.2Z" fill="currentColor" opacity="0.9" /></svg>`,
  },
  {
    label: "X",
    href: "#",
    svg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18.8 3H21l-6.9 7.9L22 21h-6.2l-4.8-6.1L5.6 21H3.4l7.4-8.5L2 3h6.3l4.4 5.6L18.8 3Z" fill="currentColor" opacity="0.9" /></svg>`,
  },
];
---

<div
  id="about"
  class="bg-backgroundlight
    min-h-screen
    flex flex-col justify-center gap-6 px-4 py-12
    md:gap-8 md:py-12
    lg:h-screen lg:flex-row lg:items-center lg:justify-center lg:gap-0 lg:overflow-visible lg:px-4 lg:py-0"
>
  <div
    class="hidden self-center w-[80vw] sm:w-[75vw] lg:w-4/5 lg:flex justify-center"
  >
    <img
      src={teamImage.src}
      width={teamImage.width}
      height={teamImage.height}
      alt="Lokasight team"
      class="w-full rounded-3xl object-cover lg:w-4/5 lg:h-[400px] xl:h-auto xl:aspect-square"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="w-full pl-0 flex flex-col lg:pl-12 gap-12 md:gap-0">
    <div class="shrink-0">
      <h2
        class="text-xl sm:text-2xl md:text-[1.75rem] lg:text-4xl font-medium leading-tight"
      >
        <span
          class="text-xs sm:text-sm md:text-lg lg:text-xl font-medium mr-2 md:mr-4 lg:mr-5"
        >
          [ABOUT]
        </span>
        Lokasight is an independent brand studio helping businesses become clearer,
        more distinctive, and easier to remember.
      </h2>
    </div>

    <div class="self-center mt-6 w-[80vw] sm:w-[75vw] md:mt-8 lg:hidden">
      <img
        src={teamImage.src}
        width={teamImage.width}
        height={teamImage.height}
        alt="Lokasight team"
        class="w-full aspect-[3/2] rounded-3xl object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="mt-4 md:mt-5 lg:mt-8 lg:grid lg:grid-cols-5">
      <div class="lg:col-start-1 lg:col-span-5 2xl:col-start-3 2xl:col-span-2">
        <p class="text-sm leading-relaxed md:text-base lg:text-lg">
          We believe strong brands begin with clear thinking. Research uncovers
          what matters, strategy defines the direction, and identity brings it
          to life.
        </p>

        <p class="mt-4 text-sm leading-relaxed md:mt-5 md:text-base lg:text-lg">
          We stay intentionally small so every project receives senior attention
          from first conversation to final delivery. This means closer
          collaboration, sharper decisions, and no unnecessary layers.
        </p>

        <div class="mt-5 flex flex-wrap gap-3 md:gap-4 lg:mt-6 lg:gap-6">
          {
            socials.map((social) => (
              <a
                href={social.href}
                aria-label={social.label}
                class={ICON_BTN}
                target="_blank"
                rel="noreferrer"
              >
                <Fragment set:html={social.svg} />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>
