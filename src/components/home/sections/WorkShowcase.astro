---
import { Picture } from "astro:assets";
import antaraCaps from "../../../assets/images/work-antara-caps-v2.png";
import hangitFootwear from "../../../assets/images/work-hangit-footwear.png";
import nusaGold from "../../../assets/images/work-nusa-gold.png";

const items = [
  { title: "Gimz", image: antaraCaps },
  { title: "Daun", image: hangitFootwear },
  { title: "Nusa", image: nusaGold },
];
---

<section class="work-showcase" aria-label="Selected work" data-work-showcase>
  <div class="work-showcase__inner">
    <div class="work-showcase__list">
      {
        items.map((item, index) => (
          <article class="work-showcase__item" data-work-item>
            <div class="work-showcase__perspective">
              <div
                class="work-showcase__card"
                data-work-card
                aria-label={`${item.title}, project ${index + 1} of ${items.length}`}
              >
                <Picture
                  src={item.image}
                  formats={["avif", "webp"]}
                  widths={[480, 720, 960, 1200, 1440]}
                  sizes="(min-width: 992px) min(88.89svh, 84rem, calc(100vw - 6rem)), (min-width: 768px) calc(100vw - 4.5rem), calc(100vw - 3rem)"
                  alt=""
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                  class="work-showcase__image"
                />

                <div class="work-showcase__name">
                  <span class="work-showcase__dot" aria-hidden="true"></span>
                  <h3>{item.title}</h3>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work-showcase {
    overflow: clip;
    background: var(--color-backgroundlight);
    color: #000;
  }

  .work-showcase__inner {
    width: 100%;
    max-width: 90rem;
    margin-inline: auto;
    padding: var(--spacing-section) var(--spacing-page-gutter) 0;
  }

  .work-showcase__list {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 8rem;
  }

  .work-showcase__item,
  .work-showcase__perspective {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
  }

  .work-showcase__perspective { perspective: 100vw; }

  .work-showcase__card {
    position: relative;
    aspect-ratio: 16 / 9;
    height: 50svh;
    max-width: 100%;
    overflow: clip;
    border-radius: 3rem;
    background: #ddd;
    contain: paint;
    transform-origin: center;
  }

  .work-showcase__card > :global(picture) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .work-showcase__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-showcase__name {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9rem;
    background: #000;
    color: #fff;
  }

  .work-showcase__name h3 {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .work-showcase__dot {
    width: 0.25rem;
    height: 0.25rem;
    flex: none;
    border-radius: 50%;
    background: #FFFF04;
  }

  @media (max-width: 1023px) {
    .work-showcase__list { gap: 5rem; }
    .work-showcase__card { width: 100%; height: auto; border-radius: 1.5rem; }
  }

  @media (max-width: 767px) {
    .work-showcase__list { gap: 1.5rem; }
    .work-showcase__card { border-radius: 1.25rem; }
  }

  @media (max-width: 479px) {
    .work-showcase__name { bottom: 1rem; left: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-showcase__card { transform: none !important; will-change: auto; }
  }
</style>

<script>
  const clamp = (value: number, min: number, max: number) =>
    Math.min(max, Math.max(min, value));
  const easeOutCubic = (value: number) => 1 - Math.pow(1 - value, 3);

  const initWorkShowcase = () => {
    document.querySelectorAll<HTMLElement>("[data-work-showcase]").forEach((section) => {
      if (section.dataset.workReady === "true") return;
      section.dataset.workReady = "true";

      const entries = Array.from(section.querySelectorAll<HTMLElement>("[data-work-item]"))
        .map((item) => {
          const card = item.querySelector<HTMLElement>("[data-work-card]");
          return card
            ? {
                item,
                card,
                top: 0,
                height: 0,
                targetProgress: 0,
                currentProgress: 0,
                paintedProgress: -1,
                promoted: false,
              }
            : null;
        })
        .filter((entry): entry is NonNullable<typeof entry> => entry !== null);

      if (!entries.length) return;

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let animationFrame = 0;
      let geometryDirty = true;
      let sectionNearby = false;
      let destroyed = false;
      let viewportHeight = window.innerHeight || 1;
      let previousTime = performance.now();

      // Card geometry only changes on resize/layout changes. Cache it so normal
      // scroll frames do not force layout before writing transforms.
      const measure = () => {
        const scrollY = window.scrollY;
        viewportHeight = window.innerHeight || 1;
        entries.forEach((entry) => {
          const rect = entry.item.getBoundingClientRect();
          entry.top = rect.top + scrollY;
          entry.height = rect.height;
        });
        geometryDirty = false;
      };

      const setTargets = () => {
        const scrollY = window.scrollY;

        entries.forEach((entry) => {
          // Alture starts when 30% of the card enters, and ends when
          // half the card has left. Both offsets are relative to the card.
          const itemTop = entry.top - scrollY;
          const startTop = viewportHeight - Math.min(entry.height * 0.3, viewportHeight);
          const endTop = entry.height * -0.5;
          entry.targetProgress = clamp((startTop - itemTop) / (startTop - endTop), 0, 1);
        });
      };

      const paint = (entry: (typeof entries)[number]) => {
        if (entry.paintedProgress === entry.currentProgress) return;

        const phase = Math.min(entry.currentProgress * 2, 1);
        const y = viewportHeight * (1 - easeOutCubic(phase));
        const rotation = 100 * (1 - phase);
        const scale = entry.currentProgress <= 0.5
          ? 1.1 - 0.1 * phase
          : 1 - 0.1 * (entry.currentProgress - 0.5) * 2;

        entry.card.style.transform =
          `translate3d(0, ${y}px, 0) scale(${scale}) rotateX(${rotation}deg)`;
        entry.paintedProgress = entry.currentProgress;
      };

      const render = (time: number) => {
        animationFrame = 0;
        if (geometryDirty) measure();
        setTargets();

        const elapsed = Math.min(time - previousTime, 64);
        const smoothing = 1 - Math.pow(0.9, elapsed / (1000 / 60));
        let unsettled = false;
        previousTime = time;

        entries.forEach((entry) => {
          // Smooth scroll progress before applying the keyframe easing.
          const delta = entry.targetProgress - entry.currentProgress;
          if (Math.abs(delta) > 0.0001) {
            entry.currentProgress += delta * smoothing;
            unsettled = true;
          } else {
            entry.currentProgress = entry.targetProgress;
          }

          const shouldPromote = entry.currentProgress > 0 && entry.currentProgress < 1;
          if (entry.promoted !== shouldPromote) {
            entry.card.style.willChange = shouldPromote ? "transform" : "auto";
            entry.promoted = shouldPromote;
          }
          paint(entry);
        });

        if (unsettled) animationFrame = requestAnimationFrame(render);
      };

      const scheduleRender = () => {
        if (
          !reducedMotion.matches &&
          sectionNearby &&
          !document.hidden &&
          !animationFrame
        ) {
          previousTime = performance.now();
          animationFrame = requestAnimationFrame(render);
        }
      };

      const invalidateGeometry = () => {
        geometryDirty = true;
        // Force a repaint even when progress itself is unchanged because the
        // viewport-relative translation can change after a resize.
        entries.forEach((entry) => { entry.paintedProgress = -1; });
        scheduleRender();
      };

      const syncInitialState = () => {
        measure();
        setTargets();
        entries.forEach((entry) => {
          entry.currentProgress = entry.targetProgress;
          paint(entry);
        });
      };

      const onMotionChange = () => {
        if (reducedMotion.matches) {
          cancelAnimationFrame(animationFrame);
          animationFrame = 0;
          entries.forEach((entry) => {
            entry.card.style.removeProperty("transform");
            entry.card.style.removeProperty("will-change");
            entry.paintedProgress = -1;
            entry.promoted = false;
          });
        } else syncInitialState();
      };

      const onVisibilityChange = () => {
        if (document.hidden) {
          cancelAnimationFrame(animationFrame);
          animationFrame = 0;
        } else {
          scheduleRender();
        }
      };

      const proximityObserver = new IntersectionObserver(([entry]) => {
        sectionNearby = entry.isIntersecting;
        if (sectionNearby) {
          geometryDirty = true;
          scheduleRender();
        } else {
          cancelAnimationFrame(animationFrame);
          animationFrame = 0;
          entries.forEach((item) => {
            item.card.style.willChange = "auto";
            item.promoted = false;
          });
        }
      }, { rootMargin: "100% 0px" });

      const resizeObserver = new ResizeObserver(invalidateGeometry);
      resizeObserver.observe(section);
      if (section.previousElementSibling) resizeObserver.observe(section.previousElementSibling);
      proximityObserver.observe(section);
      onMotionChange();
      window.addEventListener("scroll", scheduleRender, { passive: true });
      window.addEventListener("resize", invalidateGeometry);
      window.addEventListener("load", invalidateGeometry, { once: true });
      document.addEventListener("visibilitychange", onVisibilityChange);
      reducedMotion.addEventListener("change", onMotionChange);
      document.fonts?.ready.then(() => {
        if (!destroyed) invalidateGeometry();
      });

      document.addEventListener("astro:before-swap", () => {
        destroyed = true;
        cancelAnimationFrame(animationFrame);
        resizeObserver.disconnect();
        proximityObserver.disconnect();
        window.removeEventListener("scroll", scheduleRender);
        window.removeEventListener("resize", invalidateGeometry);
        window.removeEventListener("load", invalidateGeometry);
        document.removeEventListener("visibilitychange", onVisibilityChange);
        reducedMotion.removeEventListener("change", onMotionChange);
      }, { once: true });
    });
  };

  initWorkShowcase();
  document.addEventListener("astro:page-load", initWorkShowcase);
</script>
