---
import { Picture } from "astro:assets";
import antaraCaps from "../../../assets/images/work-antara-caps-v2.png";
import hangitFootwear from "../../../assets/images/work-hangit-footwear.png";
import nusaGold from "../../../assets/images/work-nusa-gold.png";

const items = [
  { title: "Gimz", image: antaraCaps },
  { title: "Daun", image: hangitFootwear },
  { title: "Nusa", image: nusaGold },
];
---

<section class="work-showcase" aria-label="Selected work" data-work-showcase>
  <div class="work-showcase__inner">
    <div class="work-showcase__list">
      {
        items.map((item, index) => (
          <article class="work-showcase__item" data-work-item>
            <div class="work-showcase__perspective">
              <div
                class="work-showcase__card"
                data-work-card
                aria-label={`${item.title}, project ${index + 1} of ${items.length}`}
              >
                <Picture
                  src={item.image}
                  formats={["avif", "webp"]}
                  widths={[480, 720, 960, 1200, 1440]}
                  sizes="(min-width: 992px) min(88.89svh, 84rem, calc(100vw - 6rem)), (min-width: 768px) calc(100vw - 4.5rem), calc(100vw - 3rem)"
                  alt=""
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                  class="work-showcase__image"
                />

                <div class="work-showcase__name">
                  <span class="work-showcase__dot" aria-hidden="true"></span>
                  <h3>{item.title}</h3>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work-showcase {
    overflow: clip;
    background: var(--color-backgroundlight);
    color: #000;
  }

  .work-showcase__inner {
    width: 100%;
    max-width: 90rem;
    margin-inline: auto;
    padding: var(--spacing-section) var(--spacing-page-gutter) 0;
  }

  .work-showcase__list {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 8rem;
  }

  .work-showcase__item,
  .work-showcase__perspective {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
  }

  .work-showcase__perspective { perspective: 100vw; }

  .work-showcase__card {
    position: relative;
    aspect-ratio: 16 / 9;
    height: 50svh;
    max-width: 100%;
    overflow: clip;
    border-radius: 3rem;
    background: #ddd;
    transform-origin: center;
  }

  .work-showcase__card > :global(picture) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .work-showcase__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-showcase__name {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9rem;
    background: #000;
    color: #fff;
    backdrop-filter: blur(20px);
  }

  .work-showcase__name h3 {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .work-showcase__dot {
    width: 0.25rem;
    height: 0.25rem;
    flex: none;
    border-radius: 50%;
    background: #FFFF04;
  }

  @media (max-width: 1023px) {
    .work-showcase__list { gap: 5rem; }
    .work-showcase__card { width: 100%; height: auto; border-radius: 1.5rem; }
  }

  @media (max-width: 767px) {
    .work-showcase__list { gap: 1.5rem; }
    .work-showcase__card { border-radius: 1.25rem; }
  }

  @media (max-width: 479px) {
    .work-showcase__name { bottom: 1rem; left: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-showcase__card { transform: none !important; will-change: auto; }
  }
</style>

<script>
  const clamp = (value: number, min: number, max: number) =>
    Math.min(max, Math.max(min, value));
  const easeOutCubic = (value: number) => 1 - Math.pow(1 - value, 3);

  const initWorkShowcase = () => {
    document.querySelectorAll<HTMLElement>("[data-work-showcase]").forEach((section) => {
      if (section.dataset.workReady === "true") return;
      section.dataset.workReady = "true";

      const entries = Array.from(section.querySelectorAll<HTMLElement>("[data-work-item]"))
        .map((item) => {
          const card = item.querySelector<HTMLElement>("[data-work-card]");
          return card
            ? { item, card, targetProgress: 0, currentProgress: 0 }
            : null;
        })
        .filter((entry): entry is NonNullable<typeof entry> => entry !== null);

      if (!entries.length) return;

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let scrollFrame = 0;
      let animationFrame = 0;
      let previousTime = performance.now();

      const setTargets = () => {
        const viewportHeight = window.innerHeight || 1;

        entries.forEach((entry) => {
          const rect = entry.item.getBoundingClientRect();
          // Alture starts when 30% of the card enters, and ends when
          // half the card has left. Both offsets are relative to the card.
          const startTop = viewportHeight - Math.min(rect.height * 0.3, viewportHeight);
          const endTop = rect.height * -0.5;
          entry.targetProgress = clamp((startTop - rect.top) / (startTop - endTop), 0, 1);
        });
      };

      const paint = (entry: (typeof entries)[number]) => {
        const phase = Math.min(entry.currentProgress * 2, 1);
        const y = window.innerHeight * (1 - easeOutCubic(phase));
        const rotation = 100 * (1 - phase);
        const scale = entry.currentProgress <= 0.5
          ? 1.1 - 0.1 * phase
          : 1 - 0.1 * (entry.currentProgress - 0.5) * 2;

        entry.card.style.transform =
          `translate3d(0, ${y}px, 0) scale(${scale}) rotateX(${rotation}deg)`;
      };

      const render = (time: number) => {
        const elapsed = Math.min(time - previousTime, 64);
        const smoothing = 1 - Math.pow(0.9, elapsed / (1000 / 60));
        let unsettled = false;
        previousTime = time;

        entries.forEach((entry) => {
          // Smooth scroll progress before applying the keyframe easing.
          const delta = entry.targetProgress - entry.currentProgress;
          if (Math.abs(delta) > 0.0001) {
            entry.currentProgress += delta * smoothing;
            unsettled = true;
          } else {
            entry.currentProgress = entry.targetProgress;
          }
          paint(entry);
        });

        animationFrame = unsettled ? requestAnimationFrame(render) : 0;
      };

      const update = () => {
        scrollFrame = 0;
        setTargets();
        if (!animationFrame) {
          previousTime = performance.now();
          animationFrame = requestAnimationFrame(render);
        }
      };

      const scheduleUpdate = () => {
        if (!reducedMotion.matches && !scrollFrame) {
          scrollFrame = requestAnimationFrame(update);
        }
      };

      const syncInitialState = () => {
        setTargets();
        entries.forEach((entry) => {
          entry.currentProgress = entry.targetProgress;
          paint(entry);
        });
      };

      const onMotionChange = () => {
        if (reducedMotion.matches) {
          cancelAnimationFrame(scrollFrame);
          cancelAnimationFrame(animationFrame);
          scrollFrame = 0;
          animationFrame = 0;
          entries.forEach(({ card }) => card.style.removeProperty("transform"));
        } else syncInitialState();
      };

      const resizeObserver = new ResizeObserver(scheduleUpdate);
      resizeObserver.observe(section);
      onMotionChange();
      window.addEventListener("scroll", scheduleUpdate, { passive: true });
      window.addEventListener("resize", scheduleUpdate);
      reducedMotion.addEventListener("change", onMotionChange);

      document.addEventListener("astro:before-swap", () => {
        cancelAnimationFrame(scrollFrame);
        cancelAnimationFrame(animationFrame);
        resizeObserver.disconnect();
        window.removeEventListener("scroll", scheduleUpdate);
        window.removeEventListener("resize", scheduleUpdate);
        reducedMotion.removeEventListener("change", onMotionChange);
      }, { once: true });
    });
  };

  initWorkShowcase();
  document.addEventListener("astro:page-load", initWorkShowcase);
</script>
