---
import { Picture } from "astro:assets";
import gmnEye from "../../../../public/gmn_eye1.png";

const NAV_ITEMS = [
  { label: "HOME", href: "#home" },
  { label: "WORK", href: "#work" },
  { label: "ABOUT", href: "#about" },
  { label: "SERVICES", href: "#services" },
  { label: "CONTACT", href: "#contact" },
];

const SOCIAL_LINKS = [
  { label: "INSTAGRAM", href: "#" },
  { label: "TIKTOK", href: "#" },
  { label: "LINKEDIN", href: "#" },
];

const POLICY_LINKS = [
  { label: "PRIVACY POLICY", href: "#" },
  { label: "TERMS OF SERVICE", href: "#" },
  { label: "COOKIE POLICY", href: "#" },
];

const FOOTER_LINK_CLASS =
  "w-fit decoration-[0.08em] underline-offset-[0.08em] transition-[opacity] duration-[160ms] ease-[ease] hover:opacity-[0.62]";
---

<footer
  id="footer-2"
  class="bg-backgroundlight grid p-4 pt-12 lg:pt-24 pb-12 w-full max-w-full grid-cols-[minmax(0,52fr)_minmax(0,24fr)_minmax(0,24fr)] grid-rows-[auto_auto] font-sans font-black  text-black "
>



  <!-- Row 1 – subgrid wrapper (no contents, just subgrid) -->
  <div class="grid grid-cols-[subgrid] col-span-full leading-[1.2] row-span-1 border ">
    <div class="min-w-0 ">
      <h2
        class="max-w-[48rem] text-[clamp(4rem,6.9vw,7.5rem)] leading-[0.82] font-black max-[900px]:text-[clamp(3.4rem,18vw,6rem)]"
      >
        <span class="block">LET'S</span>
        <span class="block">JAM <small class="ml-[0.4em] inline-block text-[clamp(1.2rem,1.75vw,2.05rem)] align-middle">(together)</small></span>
      </h2>
    </div>

    <nav
      class=" flex min-w-0 flex-col text-[clamp(1.8rem,2.45vw,3rem)] max-[900px]:text-[clamp(2.4rem,11vw,4rem)]"
      aria-label="Footer navigation"
    >
      {NAV_ITEMS.map(({ label, href }) => (
        <a href={href} class={FOOTER_LINK_CLASS}>{label}</a>
      ))}
    </nav>

    <div class="flex min-w-0 flex-col pt-[0.2rem] text-[clamp(1.2rem,1.45vw,1.8rem)]" aria-label="Social links">
      {SOCIAL_LINKS.map(({ label, href }) => (
        <a href={href} class={FOOTER_LINK_CLASS}>{label}</a>
      ))}
      <a
        class:list={[
          FOOTER_LINK_CLASS,
          "mt-auto   max-w-full whitespace-nowrap text-[clamp(1rem,1.25vw,1.65rem)] underline max-[900px]:mt-8 max-[900px]:self-start",
        ]}
        href="mailto:hello@whatmattersagency.com"
      >
        <span aria-hidden="true">↳</span>
        hello@whatmattersagency.com
      </a>
    </div>
  </div>

  <!-- Row 2 – subgrid wrapper -->
  <div class="grid grid-cols-subgrid col-span-full row-span-1 ">
    <Picture
      class="aspect-[2056/1500] w-[clamp(18rem,24vw,30rem)] object-contain object-center max-[900px]:w-[min(100%,30rem)]"
      src={gmnEye}
      formats={["webp"]}
      alt=""
      loading="lazy"
    />

    <div
      class="col-span-2 grid  grid-cols-2  self-end text-[clamp(0.95rem,1.15vw,1.45rem)]"
    >
      <div class="flex min-w-0 flex-col leading-[1.25]  justify-between">
        {POLICY_LINKS.map(({ label, href }) => (
          <a href={href} class={FOOTER_LINK_CLASS}>{label}</a>
        ))}
      </div>

      <div class="flex min-w-0 flex-col justify-between leading-[1.05]">
        <p>WEBSITE BY<br />STUDIO OFF THE WALL</p>
        <p>©2026 WHAT MATTERS AGENCY</p>
      </div>
    </div>
  </div>
</footer>
