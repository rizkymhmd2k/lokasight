---
import LokasightLogo from "../../shared/LokasightLogo.jsx";
import TextScramble from "../../shared/TextScramble.jsx";
import AnimatedEye from "../../shared/AnimatedEye.jsx";

const NAV_ITEMS = [
  { label: "HOME", href: "#home" },
  { label: "WORK", href: "#work" },
  { label: "ABOUT", href: "#about" },
  { label: "SERVICES", href: "#services" },
  { label: "CONTACT", href: "#contact" },
];

const SOCIAL_LINKS = [
  { label: "INSTAGRAM", href: "#" },
  { label: "TIKTOK", href: "#" },
  { label: "LINKEDIN", href: "#" },
];

const LINK_CLASS =
  "w-fit transition-opacity duration-200 hover:opacity-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black";
---

<footer id="site-footer" class="w-full bg-backgroundlight font-sans text-black">
  <div class="px-page pb-3 pt-section">
    <div class="grid grid-cols-1 gap-8 pb-8 md:grid-cols-12 md:gap-x-8 md:pb-10">
      <div class="md:col-span-8">
        <p class="mb-6 max-w-[18rem] text-base font-normal leading-[1.4] md:mb-8">
          Independent brand studio<br />for ambitious businesses.
        </p>
        <a
          href="mailto:hello@lokasight.com"
          class:list={[
            LINK_CLASS,
            "block border-b border-black pb-2 text-[clamp(2rem,5.3vw,5.5rem)] font-semibold leading-none tracking-[-0.02em]",
          ]}
        >
          hello@lokasight.com
        </a>
      </div>

      <div class="flex items-start md:col-span-4 md:justify-end">
        <div class="w-full max-w-[18rem]">
          <AnimatedEye client:visible />
        </div>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-x-8 gap-y-8 py-8 md:grid-cols-12 md:py-10">
      <nav class="flex flex-col font-display text-xl font-semibold leading-[1.3] md:col-span-4 md:text-2xl" aria-label="Footer navigation">
        {
          NAV_ITEMS.map(({ label, href }) => (
            <a href={href} class={LINK_CLASS} aria-label={label}>
              <TextScramble client:load text={label} />
            </a>
          ))
        }
      </nav>

      <div class="md:col-span-3 md:col-start-7">
        <p class="text-base font-normal leading-[1.4]">Bali, Indonesia<br />GMT+8</p>
      </div>

      <div class="col-span-2 md:col-span-3 md:col-start-10 md:text-right">
        <div class="flex flex-wrap gap-x-5 gap-y-2 md:flex-col md:items-end md:gap-0">
          {
            SOCIAL_LINKS.map(({ label, href }) => (
              <a href={href} class={`${LINK_CLASS} font-display text-base font-semibold leading-[1.4]`} aria-label={label}>
                <TextScramble client:load text={label} />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="overflow-hidden">
      <LokasightLogo client:visible className="w-full text-black" />
    </div>
  </div>

  <div class="flex items-start justify-between gap-4 min-h-8 whitespace-nowrap bg-yellow1 px-page pb-[0rem] pt-4 text-[clamp(0.5rem,2.2vw,0.75rem)] font-bold">
    <!-- <p>©2026 LOKASIGHT STUDIO</p>
    <p class="text-right">WEBSITE BY NEWRIZK</p> -->
  </div>
</footer>
