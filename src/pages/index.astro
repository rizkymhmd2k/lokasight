---
import Layout from "../layouts/Layout.astro";
import ViewportIndicator from "../components/dev/ViewportIndicator.jsx";
import MobileNav from "../components/layout/MobileNav.jsx";
import HeroSection from "../components/home/HeroSection.jsx";
import Work from "../components/home/sections/Work.jsx";
import Services from "../components/home/sections/Services.jsx";
import About from "../components/home/sections/About.astro";
import Contact from "../components/home/sections/Contact.jsx";
import Footer from "../components/home/sections/Footer.astro";
---

<Layout title="My Landing Page" description="A modern 2026 landing page">
  <main class="w-full">
    <ViewportIndicator client:load />
    <MobileNav client:load />
    <HeroSection client:load />

    <section
      class="
        relative z-10
        min-h-screen
        -mt-[100vh]
        bg-neutral-950
        rounded-t-4xl
      "
    >
      <Work client:load />
      <Services client:load />
      <About />
      <Contact client:load />
      <Footer />
    </section>
  </main>
</Layout>
